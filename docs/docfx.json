{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/ZoomRoomSdk/ZoomRoomSdk.csproj"],
          "src": ".."
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": ["default", "modern"],
    "postProcessors": [],
    "globalMetadata": {
      "_appTitle": "PepperDash.ZoomRoom.Sdk",
      "_appName": "PepperDash.ZoomRoom.Sdk",
      "_appFooter": "© PepperDash Technology",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/PepperDash-Engineering/zoom-room-sdk-lib",
        "branch": "main",
        "path": "docs"
      }
    },
    "sitemap": {
      "baseUrl": "https://PepperDash-Engineering.github.io/zoom-room-sdk-lib"
    }
  }
}

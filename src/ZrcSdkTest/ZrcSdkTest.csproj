<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Crestron.SimplSharp.SDK.Program" Version="2.21.184" />
  </ItemGroup>

  <!-- Copy native wrapper library to output -->
  <ItemGroup>
    <None Include="..\ZrcSdkWrapper\build-arm\libZrcSdkWrapper.so*" 
          CopyToOutputDirectory="PreserveNewest" 
          Link="%(Filename)%(Extension)"
          Condition="Exists('..\ZrcSdkWrapper\build-arm\libZrcSdkWrapper.so')" />
    <!-- Also copy ZRC SDK library -->
    <None Include="..\..\zrcsdkArm\libs\libZRCSdk.so" 
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Post-build event to ensure native library is built - temporarily disabled until ABI issues resolved
  <Target Name="BuildNativeWrapper" BeforeTargets="PreBuildEvent">
    <Message Text="Checking for native wrapper library..." Importance="high" />
    <Exec Command="cd $(ProjectDir)../ZrcSdkWrapper $(and) $(and) ./build.sh $(dash)$(dash)arm $(dash)$(dash)release" 
          Condition="!Exists('$(ProjectDir)../ZrcSdkWrapper/build-arm/libZrcSdkWrapper.so')" 
          ContinueOnError="false" />
  </Target>
  -->

</Project>
